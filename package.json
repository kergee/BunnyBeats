{
  "name": "bunnybeats",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:tauri": "vite --host 127.0.0.1 --port 8080 --strictPort",
    "build": "node tools/check-release.mjs && tsc -b && vite build && node tools/check-dist.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "check": "tsc -b",
    "serve:static": "python -m http.server 8080",
    "recover:source": "node tools/recovery/recover-source.mjs",
    "verify:recovery": "node tools/recovery/verify-source.mjs",
    "check:release": "node tools/check-release.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "0.554.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^17.0.8",
    "three": "0.181.0"
  },
  "devDependencies": {
    "@babel/generator": "7.29.7",
    "@babel/parser": "7.29.7",
    "@babel/traverse": "7.29.7",
    "@babel/types": "7.29.7",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "postcss": "8.5.30",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
